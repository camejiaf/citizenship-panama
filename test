'use client';
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import questions from './app/quiz/questions.json';

export default function QuizPage() {
    return (
        <main className="min-h-screen bg-white text-gray-900 p-4 sm:p-6">
            <div className="max-w-3xl mx-auto">
                <h1 className="text-3xl font-bold mb-6 text-center">
                    Práctica del Examen de Nacionalidad 🇵🇦
                </h1>

                <div className="space-y-8">
                    {questions.map((q, index) => (
                        <QuestionCard key={index} question={q} />
                    ))}
                </div>
                <div className="mt-10 text-center">
                    <button
                        onClick={() => router.push('/flashcards')}
                        className="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-full transition"
                    >
                        Ir a modo Flashcards
                    </button>
                </div>
            </div>
        </main>
    );
}

function QuestionCard({ question }) {
    const [selected, setSelected] = useState(null);
    const [showAnswer, setShowAnswer] = useState(false);
    const router = useRouter();

    return (
        <div className="border border-gray-300 rounded-xl p-4 shadow-sm bg-gray-50">
            <p className="font-semibold mb-4">❓ {question.question}</p>

            {question.type === 'multiple-choice' ? (
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {question.options.map((option, i) => {
                        const isCorrect = selected === option && option === question.correctAnswer;
                        const isWrong = selected === option && option !== question.correctAnswer;



                        return (
                            <button
                                key={i}
                                onClick={() => setSelected(option)}
                                disabled={selected !== null}
                                className={`w-full px-4 py-2 rounded-xl text-left border transition
                                    ${selected === null
                                        ? 'bg-white hover:bg-blue-50'
                                        : isCorrect
                                            ? 'bg-green-100 border-green-500 text-green-800'
                                            : isWrong
                                                ? 'bg-red-100 border-red-500 text-red-800'
                                                : 'bg-white opacity-50'
                                    }`}
                            >
                                {option}
                            </button>
                        );
                    })}
                </div>
            ) : (
                <details className="bg-white border-t pt-2 text-gray-700">
                    <summary
                        className="cursor-pointer text-blue-600"
                        onClick={() => setShowAnswer(!showAnswer)}
                    >
                        Mostrar respuesta
                    </summary>
                    <p className="mt-2">{question.answer}</p>
                </details>
            )}

            {/* Correct answer note */}
            {selected && question.correctAnswer && (
                <p className="mt-3 text-sm text-gray-600">
                    Respuesta correcta: <strong>{question.correctAnswer}</strong>
                </p>
            )}

            {/* Button to go back to home */}
            <div className="mt-6 text-center">
                <button
                    onClick={() => router.push('/')}
                    className="text-sm text-blue-600 hover:underline transition"
                >
                    ← Volver al inicio
                </button>
            </div>
        </div>
    );
}
